# Banco Neon (pegue a URL em console.neon.tech > Connect)
DATABASE_URL=postgresql://usuario:senha@ep-seu-projeto.us-east-1.aws.neon.tech/neondb?sslmode=require

PORT=3000
NODE_ENV=production

ENEM_API_BASE=https://api.enem.dev

# Chave para as rotas /api/carregar-ano e /api/atualizar-cache (cabeçalho X-Admin-Key).
# Gere uma longa e aleatória. Sem ela, essas rotas ficam desligadas.
ADMIN_KEY=

# Sites que podem usar a API pelo navegador, separados por vírgula.
# Se ficar vazio, vale o GitHub Pages do projeto e o localhost.
ORIGENS_PERMITIDAS=
