# Neon PostgreSQL Connection
DATABASE_URL=postgresql://user:password@ep-your-project.us-east-1.neon.tech/dbname?sslmode=require

# Server Config
PORT=3000
NODE_ENV=production

# API External
ENEM_API_BASE=https://api.enem.dev

# Keep-Alive Settings (em minutos)
KEEP_ALIVE_INTERVAL=5
CACHE_VALIDITY_DAYS=7

# Cache warming (executar a cada X minutos)
CACHE_WARMING_INTERVAL=60
