# Banco Neon (pegue a URL em console.neon.tech > Connect)
DATABASE_URL=postgresql://usuario:senha@ep-seu-projeto.us-east-1.aws.neon.tech/neondb?sslmode=require

PORT=3000
NODE_ENV=production

ENEM_API_BASE=https://api.enem.dev

# Chave para as rotas /api/carregar-ano e /api/atualizar-cache (cabeçalho X-Admin-Key).
# Gere uma longa e aleatória. Sem ela, essas rotas ficam desligadas.
ADMIN_KEY=

# Envio de e-mails (confirmação de conta e "Esqueci minha senha").
# Brevo (recomendado no Render grátis, que bloqueia SMTP): só a chave da API.
# O remetente (EMAIL_REMETENTE ou SMTP_USER) precisa estar verificado no Brevo.
BREVO_API_KEY=
# Ou por SMTP:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=o gmail,
# SMTP_PASS=uma "senha de app" (não a senha normal da conta).
# Sem isso, rodando local, o link aparece no terminal em vez de ir por e-mail.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Resend (só com domínio próprio verificado): SMTP_HOST=smtp.resend.com,
# SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=a API key (re_...).
# Com o Resend o remetente é obrigatório, ex.: M&M Estudos <contato@seudominio.com.br>.
# No Gmail é opcional. Padrão: "M&M Estudos <SMTP_USER>"
EMAIL_REMETENTE=

# Endereço do site, usado nos links dos e-mails.
SITE_URL=https://miguelpaulo3685-cyber.github.io/my-project/

# Sites que podem usar a API pelo navegador, separados por vírgula.
# Se ficar vazio, vale o GitHub Pages do projeto e o localhost.
ORIGENS_PERMITIDAS=
